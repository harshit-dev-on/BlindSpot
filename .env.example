# BlindSpot Environment Configuration Example
# Copy this file to .env or set these in your shell / environment.
# DO NOT commit files containing actual API keys to source control.

# --- Unified Route (Recommended) ---
# Configure your model and key in 2 standard variables:
# BLINDSPOT_LLM=gemini/gemini-2.5-flash
# LLM_API_KEY=your_api_key_here
# LLM_API_BASE=http://localhost:11434  # Optional: for Ollama/LMStudio/vLLM
# LLM_TIMEOUT=60.0

# --- Provider-Specific API Credentials ---
# Alternatively, set individual provider keys:

# Google Gemini API (Recommended for cloud evaluation)
# Get key: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API
# Get key: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API (Aggregator with access to many models)
# Get key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- BlindSpot Advanced Overrides (Optional) ---
# Override configured settings without modifying config.toml:

# Active category: "local" or "cloud"
# BLINDSPOT_CATEGORY=cloud

# Active provider: "gemini", "openai", "anthropic", "ollama", "openrouter", "custom"
# BLINDSPOT_PROVIDER=gemini

# Model identifier (e.g. gemini-2.5-flash, gpt-4o-mini, claude-3-7-sonnet, gemma4)
# BLINDSPOT_MODEL=gemini-2.5-flash

# Custom endpoint URL (e.g. for local Ollama, vLLM, or LM Studio)
# BLINDSPOT_BASE_URL=http://localhost:11434

# Environment variable name holding the API key
# BLINDSPOT_API_KEY_ENV=GEMINI_API_KEY

# Direct API key (prefer environment variables above for security)
# BLINDSPOT_API_KEY=

# Request timeout in seconds (default: 60.0)
# BLINDSPOT_TIMEOUT=60.0
